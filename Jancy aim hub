‎    -- TouchZone Logic
‎    local makeDraggable = function(touchObj, moveObj)
‎        local drag, activeInput, dragStartPos, startPosMove, moved
‎        touchObj.InputBegan:Connect(function(input)
‎            if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not activeInput then
‎                drag = true
‎                activeInput = input
‎                moved = false
‎                dragStartPos = input.Position
‎                startPosMove = moveObj.Position
‎            end
‎        end)
‎        UserInputService.InputChanged:Connect(function(input)
‎            if drag and input == activeInput then
‎                local delta = input.Position - dragStartPos
‎                if delta.Magnitude > 6 then moved = true end
‎                moveObj.Position = UDim2.new(startPosMove.X.Scale, startPosMove.X.Offset + delta.X, startPosMove.Y.Scale, startPosMove.Y.Offset + delta.Y)
‎            end
‎        end)
‎        UserInputService.InputEnded:Connect(function(input)
‎            if drag and input == activeInput then
‎                drag = false
‎                activeInput = nil
‎                if not moved then
‎                    isExpanded = not isExpanded
‎                    SubMenu.Visible = isExpanded
‎                    TouchZone.Size = isExpanded and UDim2.new(0, 90, 0, 245) or UDim2.new(0, 90, 0, 30)
‎                end
‎            end
‎        end)
‎    end
‎    makeDraggable(TouchZone, TouchZone)
