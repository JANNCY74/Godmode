‎    -- 🔴 HEAD ESP SYSTEM
‎    local function removeESP(head)
‎        if ESPHolders[head] then
‎            ESPHolders[head]:Destroy()
‎            ESPHolders[head] = nil
‎        end
‎    end
‎
‎    local function applyESP(player)
‎        if player == LocalPlayer then return end
‎        local isTeammate = LocalPlayer.Team and player.Team and LocalPlayer.Team == player.Team
‎        if isTeammate then return end
‎
‎        if player.Character and player.Character:FindFirstChild("Head") then
‎            local head = player.Character.Head
‎            if not ESPHolders[head] then
‎                local sphere = Instance.new("SphereHandleAdornment")
‎                sphere.Name = "HeadESP_Red"
‎                sphere.Adornee = head
‎                sphere.Radius = 0.6
‎                sphere.Color3 = Color3.fromRGB(255, 0, 0)
‎                sphere.AlwaysOnTop = true
‎                sphere.ZIndex = 10
‎                sphere.Transparency = 0.2
‎                sphere.Parent = head
‎                ESPHolders[head] = sphere
‎            end
‎        end
‎    end
‎
‎    local function updateESPState()
‎        for _, player in pairs(Players:GetPlayers()) do
‎            if player ~= LocalPlayer then
‎                if Settings.HeadESP then
‎                    applyESP(player)
‎                else
‎                    if player.Character and player.Character:FindFirstChild("Head") then
‎                        removeESP(player.Character.Head)
‎                    end
‎                end
‎            end
‎        end
‎    end
